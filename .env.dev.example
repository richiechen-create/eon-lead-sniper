# Dev sandbox config. Copy to .env.dev (gitignored) before first run.
# All defaults here are SAFE — nothing here talks to Apollo, SMTP, or Neon.
# `make dev` reads this file automatically.

# Local SQLite — wiped/re-seeded by `make reset`.
DATABASE_URL=sqlite:///./lead_engine_dev.sqlite

# Apollo: empty key. Real Apollo calls will fail, but the FakeApolloClient
# tests and the seed script don't need a real one.
APOLLO_API_KEY=

# Email: empty creds. `send_email()` will no-op or raise — the seed script
# uses a noop email sender so you can preview digests without sending them.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=dev@localhost
FROM_NAME="EON Bullseye (dev)"

# Admin alerts go nowhere by default in dev — set this if you want to
# preview admin-summary digests locally.
ADMIN_EMAIL=
DEFAULT_REP_EMAIL=dan@example.com

APP_ENV=dev
CREDIT_BUDGET_MONTHLY=9500

# Dev creds — change if paranoid, but this is a localhost-only server.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=dev
SESSION_SECRET=dev-only-not-secret-32-chars-aaaaaaa
INTERNAL_API_KEY=dev-internal-key
